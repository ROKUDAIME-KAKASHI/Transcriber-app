# Copy to .env and fill in.

# Postgres — Neon (recommended) or the local docker-compose database.
# Neon: copy both strings from the Neon console's "Connect" dialog.
#   DATABASE_URL          = pooled connection (host contains "-pooler"), used by the app
#   DATABASE_URL_UNPOOLED = direct connection, used by Prisma for db push / migrations
# Local docker (port 5433): set both to the same URL, e.g.
#   postgresql://transcriber:transcriber_password@localhost:5433/transcriber_db
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# next-auth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Deepgram (optional): the "Cloud · speaker labels" option. SERVER-SIDE ONLY, never NEXT_PUBLIC_.
# Needs the Member role (or higher) so the server can mint short-lived browser tokens.
DEEPGRAM_API_KEY=""

# AI Minutes / Reports. AICredits.in (preferred, INR billing) — an "sk-…" inference key.
AICREDITS_API_KEY=""
# The model (GLM Flash or Claude Haiku) is picked on each meeting's page; see src/lib/aiModels.ts.

# Fallback when AICREDITS_API_KEY is empty: Gemini directly.
GOOGLE_GENERATIVE_AI_API_KEY=""
