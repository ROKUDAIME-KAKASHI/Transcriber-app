# Copy to .env and fill in.

# Postgres — Neon (recommended) or the local docker-compose database.
# Neon: copy both strings from the Neon console's "Connect" dialog.
#   DATABASE_URL          = pooled connection (host contains "-pooler"), used by the app
#   DATABASE_URL_UNPOOLED = direct connection, used by Prisma for db push / migrations
# Local docker (port 5433): set both to the same URL, e.g.
#   postgresql://transcriber:transcriber_password@localhost:5433/transcriber_db
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# next-auth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Deepgram — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# Must have the Member role (or higher) so the server can mint short-lived tokens.
# A key with a lower role makes recording fail with a "needs the Member role" error.
DEEPGRAM_API_KEY=""

# Gemini, for turning transcripts into Minutes / Reports
GOOGLE_GENERATIVE_AI_API_KEY=""
