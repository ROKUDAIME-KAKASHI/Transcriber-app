# Copy to .env and fill in.

# Postgres (docker-compose.yml in this folder runs one on port 5433)
DATABASE_URL="postgresql://transcriber:transcriber_password@localhost:5433/transcriber_db"

# next-auth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# Deepgram — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_.
# The key needs the Member role (or higher) so it can mint short-lived tokens.
DEEPGRAM_API_KEY=""

# Gemini, for turning transcripts into Minutes / Reports
GOOGLE_GENERATIVE_AI_API_KEY=""
