generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  meetings  Meeting[]
  actionItems ActionItem[]
}

model Meeting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  language    String   @default("en")
  status      String   @default("RECORDING") // RECORDING | DONE
  /// TranscriptPart[]: [{ speaker: number, text: string }]
  transcript  Json     @default("[]")
  durationSec Int      @default(0)
  /// Which device recorded it, e.g. "Android phone"
  deviceName  String?
  /// "MOM" | "Report" once processed by AI
  template    String?
  /// AI-generated Markdown document
  document    String?  @db.Text
  /// Speaker number (as string) -> display name, e.g. { "0": "Asha" }
  speakerNames Json?
  /// "deepgram" | "moonshine" | "whisper"
  engine      String?
  /// Last-writer-wins clock for the title
  titleUpdatedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  actionItems ActionItem[]

  @@index([userId, createdAt])
}

model ActionItem {
  id           String    @id @default(cuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         String
  owner        String?
  /// Deadline wording exactly as spoken
  deadlineText String?
  /// Parsed deadline (unused until the tracker)
  dueDate      DateTime?
  sourceQuote  String
  /// NOT_STARTED | IN_PROGRESS | BLOCKED | DONE
  status       String    @default("NOT_STARTED")
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([meetingId])
}
