generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  meetings  Meeting[]
  actionItems ActionItem[]
  /// Public booking handle, e.g. "asha" -> /book/asha
  bookingSlug String?   @unique
  /// IANA time zone the weekly availability is expressed in
  timeZone    String?
  /// Opt-in: other Minutely users who add this person to a meeting can see busy blocks (no titles)
  shareFreeBusy Boolean @default(false)
  availability Availability[]
  eventTypes  EventType[]
  bookings    Booking[]
  agendaDrafts AgendaDraft[]
  stakeholders Stakeholder[]
  meetingSeries MeetingSeries[]
  plannedMeetings PlannedMeeting[]
}

model Meeting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  language    String   @default("en")
  status      String   @default("RECORDING") // RECORDING | DONE
  /// TranscriptPart[]: [{ speaker: number, text: string }]
  transcript  Json     @default("[]")
  durationSec Int      @default(0)
  /// Which device recorded it, e.g. "Android phone"
  deviceName  String?
  /// "MOM" | "Report" once processed by AI
  template    String?
  /// AI-generated Markdown document
  document    String?  @db.Text
  /// Speaker number (as string) -> display name, e.g. { "0": "Asha" }
  speakerNames Json?
  /// "deepgram" | "moonshine" | "whisper"
  engine      String?
  /// Last-writer-wins clock for the title
  titleUpdatedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  actionItems ActionItem[]

  @@index([userId, createdAt])
}

model ActionItem {
  id           String    @id @default(cuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         String
  owner        String?
  /// The People entry this task is assigned to (no foreign key: a deleted person keeps the owner text above)
  ownerStakeholderId String?
  /// Deadline wording exactly as spoken
  deadlineText String?
  /// Parsed deadline (unused until the tracker)
  dueDate      DateTime?
  sourceQuote  String
  /// NOT_STARTED | IN_PROGRESS | BLOCKED | DONE
  status       String    @default("NOT_STARTED")
  note         String?
  /// Soft delete: set when the user deletes the task, so its change history survives. Filtered out of every list.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  events       ActionItemEvent[]

  @@index([userId, status])
  @@index([meetingId])
}

/// One change to a task: created, one field updated, or deleted. Powers the history in the tracker.
model ActionItemEvent {
  id           String     @id @default(cuid())
  actionItemId String
  actionItem   ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  userId       String
  /// created | updated | deleted
  action       String
  /// status | owner | dueDate | note | task (updated only)
  field        String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime   @default(now())

  @@index([actionItemId, createdAt])
}

/// One weekly availability range, in the host's time zone. Minutes from midnight.
model Availability {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 = Sunday ... 6 = Saturday
  weekday  Int
  startMin Int
  endMin   Int

  @@index([userId])
}

model EventType {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  durationMin  Int
  bufferMin    Int       @default(0)
  minNoticeMin Int       @default(120)
  maxDaysAhead Int       @default(30)
  active       Boolean   @default(true)
  description  String?
  createdAt    DateTime  @default(now())
  bookings     Booking[]

  @@unique([userId, slug])
}

model Booking {
  id                   String    @id @default(cuid())
  eventTypeId          String
  eventType            EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  hostUserId           String
  host                 User      @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  guestName            String
  guestEmail           String
  guestNote            String?
  startAt              DateTime
  endAt                DateTime
  /// CONFIRMED | CANCELLED
  status               String    @default("CONFIRMED")
  /// Secret the guest needs to view, download or cancel the booking
  cancelToken          String    @unique
  agenda               String?   @db.Text
  followUpFromMeetingId String?
  /// Set when the host starts recording this meeting
  meetingId            String?
  createdAt            DateTime  @default(now())

  @@index([hostUserId, startAt])
}

/// A follow-up agenda saved so a booking link can carry it (?agenda=<id>).
model AgendaDraft {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text                  String   @db.Text
  followUpFromMeetingId String?
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
}

/// Browser and API errors, one row per fingerprint (kind + message + top frame). No transcript text or form values.
model ClientError {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  /// Signed-in user, if any. No foreign key on purpose: the log must never block deleting a user.
  userId      String?
  /// error | unhandledrejection | boundary | api
  kind        String
  message     String
  stack       String?  @db.Text
  url         String?
  userAgent   String?
  appVersion  String?
  fingerprint String
  count       Int      @default(1)
  lastSeenAt  DateTime

  @@index([fingerprint])
  @@index([createdAt])
}

/// Admin-controlled feature switches. A missing row means "use the default in src/lib/flags.ts".
model FeatureFlag {
  key       String   @id
  enabled   Boolean
  note      String?
  updatedAt DateTime @updatedAt
}

/// A person the user meets: reused when picking attendees and task owners. Soft-deleted so nothing that mentions them is ever lost.
model Stakeholder {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  designation  String?
  organisation String?
  /// Area of involvement
  area         String?
  email        String?
  phone        String?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([userId, name])
}

/// A run of related meetings (weekly review, monthly board). Soft-deleted; its plans stay.
model MeetingSeries {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  /// NONE | WEEKLY | BIWEEKLY | MONTHLY
  cadence            String           @default("NONE")
  defaultDurationMin Int              @default(30)
  defaultVenue       String?
  defaultCallUrl     String?
  /// Keep this many future meetings planned ahead (0 = off)
  keepAhead          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  plans              PlannedMeeting[]

  @@index([userId])
}

/// A meeting that exists before it happens: time, venue or link, attendees, agenda.
model PlannedMeeting {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId    String?
  series      MeetingSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  title       String
  startAt     DateTime
  durationMin Int
  /// IANA zone the host planned it in
  timeZone    String
  venue       String?
  callUrl     String?
  agenda      String?            @db.Text
  /// PLANNED | RECORDED | CANCELLED
  status      String             @default("PLANNED")
  /// The recorded Meeting. No foreign key: meetings are created on the device first and reach the server later.
  meetingId   String?            @unique
  /// The booking this plan came from, if any (no foreign key either)
  bookingId   String?            @unique
  /// iCalendar SEQUENCE: bumped when time, place or link change so invites update
  icsSequence Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  attendees   PlannedAttendee[]
  references  PlanReference[]

  @@unique([seriesId, startAt])
  @@index([userId, startAt])
}

/// One invited person on a plan. stakeholderId has no foreign key (a deleted person keeps their name here).
model PlannedAttendee {
  id               String         @id @default(cuid())
  plannedMeetingId String
  plannedMeeting   PlannedMeeting @relation(fields: [plannedMeetingId], references: [id], onDelete: Cascade)
  stakeholderId    String?
  name             String
  email            String?
  designation      String?
  role             String?
  /// When an email invite was last sent to this person
  invitedAt        DateTime?

  @@index([plannedMeetingId])
}

/// Extracted text of a reference file attached to a plan. The file itself is never stored.
model PlanReference {
  id               String         @id @default(cuid())
  plannedMeetingId String
  plannedMeeting   PlannedMeeting @relation(fields: [plannedMeetingId], references: [id], onDelete: Cascade)
  userId           String
  fileName         String
  mimeType         String
  sizeBytes        Int
  text             String         @db.Text
  /// True when the text was cut at the 200k character limit
  truncated        Boolean        @default(false)
  /// AI summary points: [{ point, source_quote, verified }]
  points           Json?
  summarizedAt     DateTime?
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?

  @@index([plannedMeetingId])
}
